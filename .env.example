# ===== Quick offline demo (no API key) =====
RAG_LLM_PROVIDER=mock
RAG_EMBEDDING_PROVIDER=hash

# ===== Recommended real LLM setup =====
# RAG_LLM_PROVIDER=gemini
# GOOGLE_API_KEY=your_google_api_key_here
# RAG_GEMINI_MODEL=gemini-2.5-flash

# ===== Hugging Face local =====
# RAG_LLM_PROVIDER=hf_local
# RAG_HF_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# RAG_HF_DEVICE=-1

# ===== vLLM/OpenAI-compatible =====
# RAG_LLM_PROVIDER=vllm
# RAG_VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# RAG_VLLM_API_BASE=http://localhost:8001/v1
# RAG_VLLM_API_KEY=EMPTY

# Embedding model matching the assignment design
# RAG_EMBEDDING_PROVIDER=hf
# RAG_EMBEDDING_MODEL=GreenNode/GreenNode-Embedding-Large-VN-Mixed-V1
# RAG_EMBEDDING_DEVICE=cpu

RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_API_URL=http://localhost:8000
